# ==============================================================================
# AI Travel Planner 환경변수 설정 템플릿 (.env.example)
# 이 파일은 버전 관리(Git)에 공유되는 템플릿입니다. 실제 비밀값은 여기에 적지 마세요.
# ==============================================================================

# 1. OpenAI 설정
# OpenAI 대시보드(https://platform.openai.com)에서 발급받은 API 키를 입력합니다.
OPENAI_API_KEY=your_openai_api_key_here

# 추천에 사용할 OpenAI 모델 ID (예: gpt-4o-mini 또는 gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# 2. Supabase 설정
# Supabase 프로젝트 설정(Project Settings -> API)에서 확인할 수 있습니다.
# Project URL (https://xxxx.supabase.co 형태)
SUPABASE_URL=https://your-project-id.supabase.co

# Project API Keys -> 'service_role' Secret Key
# 주의: service_role 키는 RLS를 우회할 수 있는 강력한 관리자 키이므로 절대 외부에 노출되면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

